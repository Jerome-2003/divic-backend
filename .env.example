
# --- added for website integration ---
# Comma-separated lists are accepted, so the PMS can be served from more than
# one origin (for example a hosted web route and a local build).
# CLIENT_ORIGIN=https://divic-pms.onrender.com,http://localhost:5173
# WEBSITE_ORIGIN=https://jerome-2003.github.io

# Set to "false" ONLY if Paystack's dashboard is already passing fees to the
# customer. Leaving both on charges the guest the fee twice.
PAYSTACK_PASS_FEES=true
