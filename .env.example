
# --- added for website integration ---
# Comma-separated lists are accepted, so the PMS can be served from more than
# one origin (for example a hosted web route and a local build).
# CLIENT_ORIGIN=https://divic-pms.onrender.com,http://localhost:5173
# WEBSITE_ORIGIN=https://jerome-2003.github.io

# Set to "false" ONLY if Paystack's dashboard is already passing fees to the
# customer. Leaving both on charges the guest the fee twice.
PAYSTACK_PASS_FEES=true

# --- guest emails (services/mailer.js) ---
# Sent over Resend's HTTP API, not SMTP — this app's free Render hosting
# blocks outbound SMTP ports (25/465/587) entirely, so an SMTP mailbox times
# out no matter how correctly it's configured. An HTTP API sends over plain
# HTTPS instead, same as every other API call this app already makes.
#
# Optional: leave RESEND_API_KEY unset and guest emails are simply skipped,
# with a one-time warning in the logs, rather than breaking anything.
#
# Get a key at https://resend.com (free tier: 3,000 emails/month). MAIL_FROM
# must be on a domain verified in the Resend dashboard (Domains -> Add
# Domain -> add the DNS records it gives you at your domain registrar) —
# sending from an unverified domain is rejected.
# RESEND_API_KEY=
# MAIL_FROM="Divic Exclusive Hotels <bookings@divicexclusivehotels.com.ng>"
